# Database Configuration
DATABASE_URL=postgresql://usuario:senha@localhost:5432/chamados_db

# API Configuration
API_VERSION=v1
API_TITLE=ChamadosHS API
API_DESCRIPTION=API de gerenciamento de chamados de suporte técnico

# Security
SECRET_KEY=sua-chave-secreta-aqui-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Webhook de notificação de técnico (n8n).
# Vazio ou ausente desliga o envio — é o padrão em desenvolvimento, para não
# disparar notificação no fluxo de produção durante testes.
# A URL contém o identificador do fluxo no n8n e vale como credencial:
# configure pelo painel, nunca versione o valor real.
WEBHOOK_TECNICO_URL=
WEBHOOK_TIMEOUT_SEGUNDOS=5

# Segredo compartilhado com o Header Auth do nó Webhook no n8n.
# Sem ele, a URL é a única credencial do fluxo.
# Gere com: openssl rand -hex 32
# Vazio = header não é enviado (padrão em desenvolvimento). Configure pelo
# painel, nunca versione o valor real.
WEBHOOK_TECNICO_TOKEN=
# Nome do header. Só mude se mudar junto no n8n.
WEBHOOK_TECNICO_HEADER=X-Webhook-Token

# Rate limiting do login (contam apenas tentativas falhas)
LOGIN_MAX_FALHAS_POR_USUARIO=10
LOGIN_MAX_FALHAS_POR_IP=50
LOGIN_JANELA_SEGUNDOS=900

# Proxies confiáveis à frente da aplicação (Easypanel/Traefik = 1).
# Use 0 se a aplicação recebe conexão direta, sem proxy.
PROXY_HOPS_CONFIAVEIS=1

# Setor que atende os chamados de destino QUALIDADE: o id dele em `setores`.
# Muda por ambiente — confira com:
#   SELECT id, nome, ativo FROM setores WHERE nome ILIKE 'qualidade';
# Vazio ou ausente = abertura para a Qualidade desligada (503); a TI não é
# afetada. Valor inválido também desliga, com aviso no log.
# Em produção, manter VAZIO até a etapa de atendimento da Qualidade (API-3)
# e o frontend estarem no ar.
SETOR_QUALIDADE_ID=

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment
ENVIRONMENT=development
